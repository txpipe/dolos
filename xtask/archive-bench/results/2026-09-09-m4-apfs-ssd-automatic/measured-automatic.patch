+            block_count: 8,
+            metadata_value: "payload".repeat(32 << 10),
+            slot: 100,
+            ..Default::default()
+        });
+        let domain: ToyDomain<FjallStores> = ToyDomain::with_backend(
+            Arc::new(dolos_cardano::include::preview::load()),
